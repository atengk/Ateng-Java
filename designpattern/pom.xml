<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 项目信息 -->
    <groupId>io.github.atengk</groupId>
    <artifactId>designpattern</artifactId>
    <version>1.0.0</version>
    <description>设计模式</description>
    <url>https://atengk.github.io</url>

    <!-- 打包方式为 POM，表示该项目为聚合项目 -->
    <packaging>pom</packaging>
    <!-- 项目包含的子模块 -->
    <modules>
        <!-- P0：最高优先级，Spring Boot 项目最常用，建议优先掌握和沉淀 -->
        <module>singleton</module>
        <module>strategy</module>
        <module>template</module>
        <module>proxy</module>
        <module>factory</module>
        <module>factorymethod</module>
        <module>builder</module>
        <module>adapter</module>
        <module>facade</module>
        <module>chain</module>

        <!-- P1：高优先级，业务复杂后非常常见 -->
        <module>observer</module>
        <module>state</module>
        <module>command</module>
        <module>decorator</module>
        <module>abstractfactory</module>
        <module>composite</module>
        <module>iterator</module>

        <!-- P2：中优先级，适合特定业务结构或复杂扩展场景 -->
        <module>bridge</module>
        <module>mediator</module>
        <module>prototype</module>
        <module>memento</module>
        <module>visitor</module>

        <!-- P3：低优先级，场景更窄，建议了解但不必优先落地 -->
        <module>flyweight</module>
        <module>interpreter</module>

        <!-- 非 GoF，但 Spring Boot 项目常用 -->
        <module>event-driven</module>
        <module>repository</module>
        <module>specification</module>
        <module>nullobject</module>
        <module>dependency-injection</module>
    </modules>
</project>