# =========================
# 自定义规则（覆盖区 / 不忽略）
# =========================

!/ateng/
!/cache/
!/kongyu/**/

!/logs/keep.log
!/config/public.yml
!/config/module-a/**/keep.yml
!module-b/keep.txt
!.env.example
!module-a/src/**/keep.json